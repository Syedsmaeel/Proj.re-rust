#!/bin/sh
#
# PROVIDE: hoffman_daemon
# REQUIRE: DAEMON
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable hoffman-daemon:
#
# hoffman_daemon_enable="YES"
#

# shellcheck source=/dev/null
. /etc/rc.subr

name="hoffman_daemon"
# shellcheck disable=SC2034
rcvar="hoffman_daemon_enable"

load_rc_config $name

: "${hoffman_daemon_enable:=NO}"

command="@bindir@/hoffman-daemon"
command_args=""
pidfile="/var/run/hoffman-daemon.pid"

# shellcheck disable=SC2034
start_cmd="${name}_start"
# shellcheck disable=SC2034
stop_cmd="${name}_stop"

hoffman_daemon_start() {
    echo "Starting ${name}."
    # command_args is intentionally unquoted to allow multiple arguments
    # shellcheck disable=SC2086
    /usr/sbin/daemon -c -f -p "${pidfile}" "${command}" ${command_args}
}

hoffman_daemon_stop() {
    if [ -f "${pidfile}" ]; then
        echo "Stopping ${name}."
        kill -TERM "$(cat "${pidfile}")"
        rm -f "${pidfile}"
    else
        echo "${name} is not running."
    fi
}

run_rc_command "$1"