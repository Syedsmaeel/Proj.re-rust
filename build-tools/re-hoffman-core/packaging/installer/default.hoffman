{
  lib,
  runCommand,
  hoffman,
  tarballs,
}:

runCommand "installer-script"
  {
    buildInputs = [ hoffman ];
  }
  ''
    mkdir -p $out/hoffman-support

    # Converts /hoffman/store/50p3qk8k...-hoffman-2.4pre20201102_550e11f/bin/hoffman to 50p3qk8k.../bin/hoffman.
    tarballPath() {
      # Remove the store prefix
      local path=''${1#${builtins.storeDir}/}
      # Get the path relative to the derivation root
      local rest=''${path#*/}
      # Get the derivation hash
      local drvHash=''${path%%-*}
      echo "$drvHash/$rest"
    }

    substitute ${./install.in} $out/install \
      ${
        lib.concatMapStrings (
          tarball:
          let
            inherit (tarball.stdenv.hostPlatform) system;
          in
          ''
            \
                   --replace '@tarballHash_${system}@' $(hoffman --experimental-features hoffman-command hash-file --base16 --type sha256 ${tarball}/*.tar.xz) \
                   --replace '@tarballPath_${system}@' $(tarballPath ${tarball}/*.tar.xz) \
          ''
        ) tarballs
      } --replace '@hoffmanVersion@' ${hoffman.version}

    echo "file installer $out/install" >> $out/hoffman-support/hydra-build-products
  ''
