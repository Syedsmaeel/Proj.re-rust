# `HoffmanOS/hoffman-installer` built with *this* Hoffman closure embedded, so
# Hydra/CI can dogfood the Rust installer without the (removed)
# `--hoffman-package-url` knob.
{
  lib,
  stdenv,
  buildPackages,
  runCommand,
  rustPlatform,
  fetchFromGitHub,
  tarball,
}:

let
  installerVersion = "2.34.6";
  src = fetchFromGitHub {
    owner = "HoffmanOS";
    repo = "hoffman-installer";
    tag = installerVersion;
    hash = "sha256-aTaz8EtHexvke7tGr5MfeKy9g7AraIAFN+dPApm+fds=";
  };

  # Bare binary: no Hoffman closure yet.  Appended below via `pack`, so the
  # (expensive) Rust compile is independent of the embedded Hoffman and
  # stays cacheable across Hoffman revisions.
  bare = rustPlatform.buildRustPackage {
    pname = "hoffman-installer-bare";
    version = installerVersion;

    inherit src;

    cargoHash = "sha256-/mNXkeZVuYsqd0TiUa7bzSP4xpKh0Fqga9EpasPbrzU=";

    doCheck = false;

    env = lib.optionalAttrs stdenv.hostPlatform.isDarwin {
      # Drop the unused libiconv dylib the darwin stdenv injects; the
      # binary must run before `/hoffman/store` exists.
      HOFFMAN_LDFLAGS = "-dead_strip_dylibs";
    };

    postInstall = ''
      install -m755 hoffman-installer.sh $out/bin/hoffman-installer.sh
    '';
  };
in

runCommand "hoffman-installer-${tarball.passthru.hoffmanVersion}"
  {
    nativeBuildInputs = [
      buildPackages.python3
    ]
    ++ lib.optionals stdenv.hostPlatform.isDarwin [
      buildPackages.darwin.sigtool
      buildPackages.darwin.cctools
    ];

    # The appended payload contains store-path strings on purpose; don't
    # let the reference scanner pull the whole Hoffman closure into this
    # derivation's runtime closure.
    __structuredAttrs = true;
    unsafeDiscardReferences.out = true;

    passthru = { inherit bare; };

    meta = {
      description = "Rust-based Hoffman installer with an embedded Hoffman ${tarball.passthru.hoffmanVersion}";
      homepage = "https://github.com/HoffmanOS/hoffman-installer";
      license = lib.licenses.lgpl21Only;
      mainProgram = "hoffman-installer";
    };
  }
  ''
    mkdir -p $out/bin $out/hoffman-support

    python3 ${src}/scripts/pack \
      --input ${bare}/bin/hoffman-installer \
      --tarball ${tarball}/hoffman.tar.zst \
      --hoffman-store-path ${tarball.passthru.hoffmanStorePath} \
      --cacert-store-path ${tarball.passthru.cacertStorePath} \
      --hoffman-version ${tarball.passthru.hoffmanVersion} \
      --output $out/bin/hoffman-installer

    install -m755 ${bare}/bin/hoffman-installer.sh $out/bin/hoffman-installer.sh

    echo "file binary-dist $out/bin/hoffman-installer" >> $out/hoffman-support/hydra-build-products
    echo "file binary-dist $out/bin/hoffman-installer.sh" >> $out/hoffman-support/hydra-build-products
  ''
