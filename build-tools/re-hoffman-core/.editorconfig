# EditorConfig configuration for hoffman
# http://EditorConfig.org

# Top-most EditorConfig file
root = true

# Uhoffman-style newlines with a newline ending every file, UTF-8 charset
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Match Hoffman files, set indent to spaces with width of two
[*.hoffman]
indent_style = space
indent_size = 2

# Match C++/C/shell/Perl, set indent to spaces with width of four
[*.{hpp,cc,hh,c,h,sh,pl,xs}]
indent_style = space
indent_size = 4

# Match diffs, avoid to trim trailing whitespace
[*.{diff,patch}]
trim_trailing_whitespace = false
