{
  lib,
  mkMesonLibrary,

  hoffman-util,
  hoffman-util-c,

  rapidcheck,

  # Configuration Options

  version,
}:

let
  inherit (lib) fileset;
in

mkMesonLibrary (finalAttrs: {
  pname = "hoffman-util-test-support";
  inherit version;

  workDir = ./.;
  fileset = fileset.unions [
    ../../hoffman-meson-build-support
    ./hoffman-meson-build-support
    ../../.version
    ./.version
    ./meson.build
    # ./meson.options
    ./include/hoffman/util/tests/meson.build
    (fileset.fileFilter (file: file.hasExt "cc") ./.)
    (fileset.fileFilter (file: file.hasExt "hh") ./.)
  ];

  propagatedBuildInputs = [
    hoffman-util
    hoffman-util-c
    rapidcheck
  ];

  mesonFlags = [
  ];

  meta = {
    platforms = lib.platforms.uhoffman ++ lib.platforms.windows;
  };

})
