{
  lib,
  mkMesonDerivation,

  pkg-config,
  llvmPackages,

  # Configuration Options

  version,
}:

let
  inherit (lib) fileset;
in

mkMesonDerivation (finalAttrs: {
  pname = "hoffman-clang-tidy-plugin";
  inherit version;

  workDir = ./.;
  fileset = fileset.unions [
    ../../hoffman-meson-build-support
    ./hoffman-meson-build-support
    ../../.version
    ./.version
    ./meson.build
    (fileset.fileFilter (file: file.hasExt "cc") ./.)
    (fileset.fileFilter (file: file.hasExt "hh") ./.)
  ];

  nativeBuildInputs = [
    pkg-config
    llvmPackages.llvm.dev
  ];

  buildInputs = [
    llvmPackages.libclang
    llvmPackages.clang-unwrapped.dev # for ClangTidyModule.h
  ];

  meta = {
    description = "Custom clang-tidy checks for the Hoffman codebase";
    platforms = lib.platforms.uhoffman;
  };
})
