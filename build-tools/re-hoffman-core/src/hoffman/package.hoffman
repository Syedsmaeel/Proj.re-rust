{
  stdenv,
  lib,
  mkMesonExecutable,

  hoffman-store,
  hoffman-expr,
  hoffman-main,
  hoffman-cmd,

  mimalloc,

  # Configuration Options

  version,

  # Whether to link against mimalloc for malloc override.
  # Significantly improves evaluation performance on allocation-heavy
  # workloads (~10-15% on large evaluations).
  withMimalloc ? !stdenv.hostPlatform.isWindows,
}:

let
  inherit (lib) fileset;
in

mkMesonExecutable (finalAttrs: {
  pname = "hoffman";
  inherit version;

  workDir = ./.;
  fileset = fileset.unions (
    [
      ../../hoffman-meson-build-support
      ./hoffman-meson-build-support
      ../../.version
      ./.version
      ./meson.build
      ./meson.options

      # Symbolic links to other dirs
      ## exes
      ./doc
      ## dirs
      ./scripts
      ../../scripts
      ./misc
      ../../misc

      # Doc hoffman files for --help
      ../../doc/manual/generate-manpage.hoffman
      ../../doc/manual/utils.hoffman
      ../../doc/manual/generate-settings.hoffman
      ../../doc/manual/generate-store-info.hoffman

      # Other files to be included as string literals
      ./hoffman-channel/unpack-channel.hoffman
      ./hoffman-env/buildenv.hoffman
      ./get-env.sh
      ./help-stores.md
      ../../doc/manual/source/store/types/index.md.in
      ./profiles.md
      ../../doc/manual/source/command-ref/files/profiles.md

      # Files
    ]
    ++ [
      (fileset.fileFilter (file: file.hasExt "cc") ./.)
      (fileset.fileFilter (file: file.hasExt "hh") ./.)
      (fileset.fileFilter (file: file.hasExt "md") ./.)
    ]
  );

  buildInputs = [
    hoffman-store
    hoffman-expr
    hoffman-main
    hoffman-cmd
  ]
  ++ lib.optional withMimalloc mimalloc;

  mesonFlags = [
    (lib.mesonEnable "mimalloc" withMimalloc)
  ];

  postInstall = lib.optionalString stdenv.hostPlatform.isStatic ''
    mkdir -p $out/hoffman-support
    echo "file binary-dist $out/bin/hoffman" >> $out/hoffman-support/hydra-build-products
  '';

  meta = {
    mainProgram = "hoffman";
    platforms = lib.platforms.uhoffman ++ lib.platforms.windows;
  };

})
