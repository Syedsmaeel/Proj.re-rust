{
  lib,
  mkMesonLibrary,

  openssl,

  hoffman-util,
  hoffman-store,
  hoffman-expr,

  # Configuration Options

  version,
}:

let
  inherit (lib) fileset;
in

mkMesonLibrary (finalAttrs: {
  pname = "hoffman-main";
  inherit version;

  workDir = ./.;
  fileset = fileset.unions [
    ../../hoffman-meson-build-support
    ./hoffman-meson-build-support
    ../../.version
    ./.version
    ./meson.build
    ./include/hoffman/main/meson.build
    (fileset.fileFilter (file: file.hasExt "cc") ./.)
    (fileset.fileFilter (file: file.hasExt "hh") ./.)
  ];

  propagatedBuildInputs = [
    # FIXME: This is only here for the HOFFMAN_USE_BOEHMGC macro dependency
    #        Removing hoffman-expr will make the build more concurrent and is
    #        architecturally nice, perhaps.
    hoffman-expr
    hoffman-util
    hoffman-store
    openssl
  ];

  meta = {
    platforms = lib.platforms.uhoffman ++ lib.platforms.windows;
  };

})
