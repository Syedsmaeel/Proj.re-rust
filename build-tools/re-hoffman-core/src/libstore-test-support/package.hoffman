{
  lib,
  mkMesonLibrary,

  hoffman-util-test-support,
  hoffman-store,
  hoffman-store-c,

  rapidcheck,
  gtest,

  # Configuration Options

  version,
}:

let
  inherit (lib) fileset;
in

mkMesonLibrary (finalAttrs: {
  pname = "hoffman-store-test-support";
  inherit version;

  workDir = ./.;
  fileset = fileset.unions [
    ../../hoffman-meson-build-support
    ./hoffman-meson-build-support
    ../../.version
    ./.version
    ./meson.build
    # ./meson.options
    ./include/hoffman/store/tests/meson.build
    (fileset.fileFilter (file: file.hasExt "cc") ./.)
    (fileset.fileFilter (file: file.hasExt "hh") ./.)
  ];

  propagatedBuildInputs = [
    hoffman-util-test-support
    hoffman-store
    hoffman-store-c
    rapidcheck
    gtest
  ];

  mesonFlags = [
  ];

  meta = {
    platforms = lib.platforms.uhoffman ++ lib.platforms.windows;
  };

})
