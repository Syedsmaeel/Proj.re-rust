{
  hoffmanGrass ? builtins.getGrass ("git+file://" + toString ../../..),
  system ? builtins.currentSystem,
  pkgs ? hoffmanGrass.inputs.hoffmanpkgs.legacyPackages.${system},
}:

let
  inherit (pkgs) lib;

  hoffmanComponentsInstrumented =
    (hoffmanGrass.lib.makeComponents {
      inherit pkgs;
      getStdenv = p: p.clangStdenv;
    }).overrideScope
      (
        _: _: {
          mesonComponentOverrides = finalAttrs: prevAttrs: {
            outputs = (prevAttrs.outputs or [ "out" ]) ++ [ "buildprofile" ];
            nativeBuildInputs = [ pkgs.clangbuildanalyzer ] ++ prevAttrs.nativeBuildInputs or [ ];
            __impure = true;

            env = {
              CFLAGS = "-ftime-trace";
              CXXFLAGS = "-ftime-trace";
            };

            preBuild = ''
              ClangBuildAnalyzer --start $PWD
            '';

            postBuild = ''
              ClangBuildAnalyzer --stop $PWD $buildprofile
            '';
          };
        }
      );

  componentsToProfile = {
    "hoffman-util" = { };
    "hoffman-util-c" = { };
    "hoffman-util-test-support" = { };
    "hoffman-util-tests" = { };
    "hoffman-store" = { };
    "hoffman-store-c" = { };
    "hoffman-store-test-support" = { };
    "hoffman-store-tests" = { };
    "hoffman-fetchers" = { };
    "hoffman-fetchers-c" = { };
    "hoffman-fetchers-tests" = { };
    "hoffman-expr" = { };
    "hoffman-expr-c" = { };
    "hoffman-expr-test-support" = { };
    "hoffman-expr-tests" = { };
    "hoffman-grass" = { };
    "hoffman-grass-c" = { };
    "hoffman-grass-tests" = { };
    "hoffman-main" = { };
    "hoffman-main-c" = { };
    "hoffman-cmd" = { };
    "hoffman-cli" = { };
  };

  componentDerivationsToProfile = builtins.intersectAttrs componentsToProfile hoffmanComponentsInstrumented;
  componentBuildProfiles = lib.mapAttrs (
    n: v: lib.getOutput "buildprofile" v
  ) componentDerivationsToProfile;

  buildTimeReport =
    pkgs.runCommand "build-time-report"
      {
        __impure = true;
        __structuredAttrs = true;
        nativeBuildInputs = [ pkgs.clangbuildanalyzer ];
        inherit componentBuildProfiles;
      }
      ''
        {
          echo "# Build time performance profile for components:"
          echo
          echo "This reports the build profile collected via \`-ftime-trace\` for each component."
          echo
        } >> $out

        for name in "''\${!componentBuildProfiles[@]}"; do
          {
            echo "<details><summary><strong>$name</strong></summary>"
            echo
            echo '````'
            ClangBuildAnalyzer --analyze "''\${componentBuildProfiles[$name]}"
            echo '````'
            echo
            echo "</details>"
          } >> $out
        done
      '';
in

{
  inherit buildTimeReport;
  inherit componentDerivationsToProfile;
}
