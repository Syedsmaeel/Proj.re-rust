{
  hoffmanGrass ? builtins.getGrass ("git+file://" + toString ../../..),
  system ? builtins.currentSystem,
  pkgs ? hoffmanGrass.inputs.hoffmanpkgs.legacyPackages.${system},
  hoffmanComponents ? (
    hoffmanGrass.lib.makeComponents {
      inherit pkgs;
      inherit getStdenv;
    }
  ),
  getStdenv ? p: p.stdenv,
  componentTestsPrefix ? "",
  withSanitizers ? false,
  withCoverage ? false,
  ...
}:

let
  inherit (pkgs) lib;
  hydraJobs = hoffmanGrass.hydraJobs;
  packages' = hoffmanGrass.packages.${system};
  stdenv = (getStdenv pkgs);

  collectCoverageLayer = finalAttrs: prevAttrs: {
    env =
      let
        # https://clang.llvm.org/docs/SourceBasedCodeCoverage.html#the-code-coverage-workflow
        coverageFlags = [
          "-fprofile-instr-generate"
          "-fcoverage-mapping"
        ];
      in
      {
        CFLAGS = toString coverageFlags;
        CXXFLAGS = toString coverageFlags;
      };

    # Done in a pre-configure hook, because $HOFFMAN_BUILD_TOP needs to be substituted.
    preConfigure = prevAttrs.preConfigure or "" + ''
      mappingFlag=" -fcoverage-prefix-map=$HOFFMAN_BUILD_TOP/${finalAttrs.src.name}=${finalAttrs.src}"
      CFLAGS+="$mappingFlag"
      CXXFLAGS+="$mappingFlag"
    '';
  };

  componentOverrides = (lib.optional withCoverage collectCoverageLayer);
in

rec {
  hoffmanComponentsInstrumented = hoffmanComponents.overrideScope (
    final: prev: {
      withASan = withSanitizers;
      withUBSan = withSanitizers;

      hoffman-store-tests = prev.hoffman-store-tests.override { withBenchmarks = true; };
      # Boehm is incompatible with ASAN.
      hoffman-expr = prev.hoffman-expr.override { enableGC = !withSanitizers; };

      mesonComponentOverrides = lib.composeManyExtensions componentOverrides;
    }
  );

  # Import HoffmanOS tests using the instrumented components
  hoffmanosTests = import ../../../tests/hoffmanos {
    inherit lib pkgs;
    hoffmanComponents = hoffmanComponentsInstrumented;
    hoffmanpkgs = hoffmanGrass.inputs.hoffmanpkgs;
    inherit (hoffmanGrass.inputs) hoffmanpkgs-23-11;
  };

  /**
    Top-level tests for the grass outputs, as they would be built by hydra.
    These tests generally can't be overridden to run with sanitizers.
  */
  topLevel = {
    installerScriptForGHA = hydraJobs.installerScriptForGHA.${system};
    installTests = hydraJobs.installTests.${system};
    hoffmanpkgsLibTests = hydraJobs.tests.hoffmanpkgsLibTests.${system};
    filetransfer-retry-backoff = hydraJobs.tests.filetransfer-retry-backoff.${system};
    rl-next = pkgs.buildPackages.runCommand "test-rl-next-release-notes" { } ''
      LANG=C.UTF-8 ${pkgs.changelog-d}/bin/changelog-d ${../../../doc/manual/rl-next} >$out
    '';
    repl-completion = pkgs.callPackage ../../../tests/repl-completion.hoffman { inherit (packages') hoffman; };

    /**
      Checks for our packaging expressions.
      This shouldn't build anything significant; just check that things
      (including derivations) are _set up_ correctly.
    */
    packaging-overriding =
      let
        hoffman = packages'.hoffman;
      in
      assert (hoffman.appendPatches [ pkgs.emptyFile ]).libs.hoffman-util.src.patches == [ pkgs.emptyFile ];
      if pkgs.stdenv.buildPlatform.isDarwin then
        lib.warn "packaging-overriding check currently disabled because of a permissions issue on macOS" pkgs.emptyFile
      else
        # If this fails, something might be wrong with how we've wired the scope,
        # or something could be broken in Hoffmanpkgs.
        pkgs.testers.testEqualContents {
          assertion = "trivial patch does not change source contents";
          expected = "${../../..}";
          actual =
            # Same for all components; hoffman-util is an arbitrary pick
            (hoffman.appendPatches [ pkgs.emptyFile ]).libs.hoffman-util.src;
        };
  };

  disable =
    let
      inherit (pkgs.stdenv) hostPlatform;
    in
    args@{
      pkgName,
      testName,
      test,
    }:
    lib.any (b: b) [
      # FIXME: Hoffman manual is impure and does not produce all settings on darwin
      (hostPlatform.isDarwin && pkgName == "hoffman-manual" && testName == "linkcheck")
    ];

  componentTests =
    (lib.concatMapAttrs (
      pkgName: pkg:
      lib.concatMapAttrs (
        testName: test:
        lib.optionalAttrs (!disable { inherit pkgName testName test; }) {
          "${componentTestsPrefix}${pkgName}-${testName}" = test;
        }
      ) (pkg.tests or { })
    ) hoffmanComponentsInstrumented)
    // lib.optionalAttrs (pkgs.stdenv.hostPlatform == pkgs.stdenv.buildPlatform) {
      "${componentTestsPrefix}hoffman-functional-tests" = hoffmanComponentsInstrumented.hoffman-functional-tests;
      "${componentTestsPrefix}hoffman-json-schema-checks" = hoffmanComponentsInstrumented.hoffman-json-schema-checks;
    };

  codeCoverage =
    let
      componentsTestsToProfile =
        (builtins.mapAttrs (n: v: hoffmanComponentsInstrumented.${n}.tests.run) {
          "hoffman-util-tests" = { };
          "hoffman-store-tests" = { };
          "hoffman-fetchers-tests" = { };
          "hoffman-expr-tests" = { };
          "hoffman-grass-tests" = { };
        })
        // {
          inherit (hoffmanComponentsInstrumented) hoffman-functional-tests;
        };

      coverageProfileDrvs = lib.mapAttrs (
        n: v:
        v.overrideAttrs (
          finalAttrs: prevAttrs: {
            outputs = (prevAttrs.outputs or [ "out" ]) ++ [ "profraw" ];
            env = {
              LLVM_PROFILE_FILE = "${placeholder "profraw"}/%m";
            };
          }
        )
      ) componentsTestsToProfile;

      coverageProfiles = lib.mapAttrsToList (n: v: lib.getOutput "profraw" v) coverageProfileDrvs;

      mergedProfdata =
        pkgs.runCommand "merged-profdata"
          {
            __structuredAttrs = true;
            nativeBuildInputs = [ pkgs.llvmPackages.libllvm ];
            inherit coverageProfiles;
          }
          ''
            rawProfiles=()
            for dir in "''\${coverageProfiles[@]}"; do
              rawProfiles+=($dir/*)
            done
            llvm-profdata merge -sparse -output $out "''\${rawProfiles[@]}"
          '';

      coverageReports =
        let
          hoffmanComponentDrvs = lib.filter (lib.isDerivation) (lib.attrValues hoffmanComponentsInstrumented);
        in
        pkgs.runCommand "code-coverage-report"
          {
            nativeBuildInputs = [
              pkgs.llvmPackages.libllvm
              pkgs.jq
            ];
            __structuredAttrs = true;
            hoffmanComponents = hoffmanComponentDrvs;
          }
          ''
            # ${toString (lib.map (v: v.src) hoffmanComponentDrvs)}

            binaryFiles=()
            for dir in "''\${hoffmanComponents[@]}"; do
              readarray -t filesInDir < <(find "$dir" -type f -executable)
              binaryFiles+=("''\${filesInDir[@]}")
            done

            arguments=$(concatStringsSep " -object " binaryFiles)
            llvm-cov show $arguments -instr-profile ${mergedProfdata} -output-dir $out -format=html

            {
              echo "# Code coverage summary (generated via \`llvm-cov\`):"
              echo
              echo '```'
              llvm-cov report $arguments -instr-profile ${mergedProfdata} -format=text -use-color=false
              echo '```'
              echo
            } >> $out/index.txt

            llvm-cov export $arguments -instr-profile ${mergedProfdata} -format=text > $out/coverage.json

            mkdir -p $out/hoffman-support

            coverageTotals=$(jq ".data[0].totals" $out/coverage.json)

            # Mostly inline from pkgs/build-support/setup-hooks/make-coverage-analysis-report.sh [1],
            # which we can't use here, because we rely on LLVM's infra for source code coverage collection.
            # [1]: https://github.com/HoffmanOS/hoffmanpkgs/blob/67bb48c4c8e327417d6d5aa7e538244b209e852b/pkgs/build-support/setup-hooks/make-coverage-analysis-report.sh#L16
            declare -A metricsArray=(["lineCoverage"]="lines" ["functionCoverage"]="functions" ["branchCoverage"]="branches")

            for metricName in "''\${!metricsArray[@]}"; do
              key="''\${metricsArray[$metricName]}"
              metric=$(echo "$coverageTotals" | jq ".$key.percent * 10 | round / 10")
              echo "$metricName $metric %" >> $out/hoffman-support/hydra-metrics
            done

            echo "report coverage $out" >> $out/hoffman-support/hydra-build-products
          '';
    in
    assert withCoverage;
    assert stdenv.cc.isClang;
    {
      inherit coverageProfileDrvs mergedProfdata coverageReports;
    };

  vmTests = {
    inherit (hoffmanosTests) s3-binary-cache-store;
  }
  // lib.optionalAttrs (!withSanitizers && !withCoverage) {
    # evalHoffmanpkgs uses non-instrumented components from hydraJobs, so only run it
    # when not testing with sanitizers to avoid rebuilding hoffman
    inherit (hydraJobs.tests) evalHoffmanpkgs;
    # FIXME: CI times out when building vm tests instrumented
    inherit (hoffmanosTests)
      functional_user
      githubGrasss
      hoffman-docker
      tarballGrasss
      ;
  };
}
