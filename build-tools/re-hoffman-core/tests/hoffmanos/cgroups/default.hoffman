{ hoffmanpkgs, ... }:

{
  name = "cgroups";

  nodes = {
    host =
      { config, pkgs, ... }:
      {
        virtualisation.additionalPaths = [ pkgs.stdenvNoCC ];
        hoffman.extraOptions = ''
          extra-experimental-features = hoffman-command auto-allocate-uids cgroups
          extra-system-features = uid-range
        '';
        hoffman.settings.use-cgroups = true;
        hoffman.hoffmanPath = [ "hoffmanpkgs=${hoffmanpkgs}" ];
      };
  };

  testScript =
    { nodes }:
    ''
      start_all()

      host.wait_for_unit("multi-user.target")

      # Start build in background
      host.execute("HOFFMAN_REMOTE=daemon hoffman build --auto-allocate-uids --file ${./hang.hoffman} >&2 &")
      service = "/sys/fs/cgroup/system.slice/hoffman-daemon.service"

      # Wait for cgroups to be created
      host.succeed(f"until [ -e {service}/hoffman-daemon ]; do sleep 1; done", timeout=30)
      host.succeed(f"until [ -e {service}/hoffman-build-uid-* ]; do sleep 1; done", timeout=30)

      # Check that there aren't processes where there shouldn't be, and that there are where there should be
      host.succeed(f'[ -z "$(cat {service}/cgroup.procs)" ]')
      host.succeed(f'[ -n "$(cat {service}/hoffman-daemon/cgroup.procs)" ]')
      host.succeed(f'[ -n "$(cat {service}/hoffman-build-uid-*/cgroup.procs)" ]')
    '';

}
