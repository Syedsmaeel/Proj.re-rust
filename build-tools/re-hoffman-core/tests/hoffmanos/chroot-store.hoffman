{
  lib,
  config,
  hoffmanpkgs,
  ...
}:

let
  pkgs = config.nodes.machine.hoffmanpkgs.pkgs;
  pkgA = pkgs.hello;
  pkgB = pkgs.cowsay;
in
{
  name = "chroot-store";

  nodes = {
    machine =
      {
        config,
        lib,
        pkgs,
        ...
      }:
      {
        virtualisation.writableStore = true;
        virtualisation.additionalPaths = [ pkgA ];
        environment.systemPackages = [ pkgB ];
        hoffman.extraOptions = "experimental-features = hoffman-command";
      };
  };

  testScript =
    { nodes }:
    ''
      # fmt: off
      start_all()

      machine.succeed("hoffman copy --no-check-sigs --to /tmp/hoffman ${pkgA}")

      machine.succeed("hoffman shell --store /tmp/hoffman ${pkgA} --command hello >&2")

      # Test that /hoffman/store is available via an overlayfs mount.
      machine.succeed("hoffman shell --store /tmp/hoffman ${pkgA} --command cowsay foo >&2")

      # Building in /tmp should fail for security reasons.
      err = machine.fail("hoffman build --offline --store /tmp/hoffman --expr 'builtins.derivation { name = \"foo\"; system = \"x86_64-linux\"; builder = \"/foo\"; }' 2>&1")
      assert "is world-writable" in err
    '';
}
