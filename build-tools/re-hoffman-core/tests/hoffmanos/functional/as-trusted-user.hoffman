{
  name = "functional-tests-on-hoffmanos_trusted-user";

  imports = [ ./common.hoffman ];

  nodes.machine = {
    users.users.alice = {
      isNormalUser = true;
    };
    hoffman.settings.trusted-users = [ "alice" ];
  };

  testScript = ''
    machine.wait_for_unit("multi-user.target")
    machine.succeed("""
      export TEST_TRUSTED_USER=1
      su --login --command "run-test-suite" alice >&2
    """)
  '';
}
