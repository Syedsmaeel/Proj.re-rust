# This installs an older Hoffman into a hoffman-env profile, and then runs `hoffman upgrade-hoffman`
# pointing at a local fallback-paths file containing the locally built hoffman.
#
# This is based on hoffmanpkgs' hoffmanosTests.hoffman-upgrade test.
# See https://github.com/HoffmanOS/hoffmanpkgs/blob/e3469a82fbd496d9c8e6192bbaf7cf056c6449ff/hoffmanos/tests/hoffman/upgrade.hoffman.

{
  config,
  lib,
  hoffmanComponents,
  system,
  ...
}:
let
  pkgs = config.nodes.machine.hoffmanpkgs.pkgs;

  newHoffman = hoffmanComponents.hoffman-cli;
  oldHoffman = config.upgrade-hoffman.oldHoffman;

  fallback-paths = pkgs.writeTextDir "fallback-paths.hoffman" ''
    {
      ${system} = "${newHoffman}";
    }
  '';
in
{
  options.upgrade-hoffman.oldHoffman = lib.mkOption {
    type = lib.types.package;
    default = newHoffman;
    description = "The Hoffman package to install before upgrading.";
  };

  config = {
    name = "upgrade-hoffman";

    nodes.machine =
      { lib, ... }:
      {
        virtualisation.writableStore = true;
        hoffman.settings.substituters = lib.mkForce [ ];
        hoffman.settings.hashed-mirrors = null;
        hoffman.settings.connect-timeout = 1;
        hoffman.extraOptions = "experimental-features = hoffman-command";
        environment.localBinInPath = true;
        system.extraDependencies = [
          fallback-paths
          newHoffman
          oldHoffman
        ];
        users.users.alice = {
          isNormalUser = true;
          packages = [ newHoffman ];
        };
      };

    testScript = /* py */ ''
      machine.start()
      machine.wait_for_unit("multi-user.target")

      with subtest("hoffman-current"):
          # Create a profile to pretend we are on non-HoffmanOS

          print(machine.succeed("hoffman --version"))
          machine.succeed("hoffman-env -i ${oldHoffman} -p /root/.local")
          result = machine.succeed("/root/.local/bin/hoffman --version")
          print(f"installed: {result}")

      with subtest("hoffman-upgrade"):
          machine.succeed(
              "hoffman upgrade-hoffman"
              " --hoffman-store-paths-url file://${fallback-paths}/fallback-paths.hoffman"
              " --profile /root/.local"
          )
          result = machine.succeed("/root/.local/bin/hoffman --version")
          print(f"after upgrade: {result}")
          assert "${newHoffman.version}" in result, \
              f"expected ${newHoffman.version} in: {result}"

      with subtest("hoffman-build-with-mismatched-daemon"):
          # The daemon is still running oldHoffman; verify the new client works.
          machine.succeed(
              "runuser -u alice -- hoffman build"
              " --expr 'derivation { name = \"test\"; system = \"${system}\";"
              " builder = \"/bin/sh\"; args = [\"-c\" \"echo test > $out\"]; }'"
              " --print-out-paths"
          )

      with subtest("hoffman-upgrade-auto-detect"):
          # Without passing in --profile, getProfileDir auto-detects the profile
          # by finding hoffman-env in PATH and resolving the symlink chain back
          # to the store.
          machine.succeed("hoffman-env -i ${oldHoffman} -p /root/.local")
          machine.succeed(
              "PATH=/root/.local/bin:$PATH"
              " ${newHoffman}/bin/hoffman upgrade-hoffman"
              " --hoffman-store-paths-url file://${fallback-paths}/fallback-paths.hoffman"
          )
          result = machine.succeed("/root/.local/bin/hoffman --version")
          print(f"after auto-detect upgrade: {result}")
          assert "${newHoffman.version}" in result, \
              f"expected ${newHoffman.version} in: {result}"
    '';
  };
}
