{
  lib,
  pkgs,
  hoffmanComponents,
  hoffmanpkgs,
  hoffmanpkgs-23-11,
}:

let

  hoffmanos-lib = import (hoffmanpkgs + "/hoffmanos/lib") { };

  noTests =
    pkg:
    pkg.overrideAttrs (
      finalAttrs: prevAttrs: {
        doCheck = false;
        doInstallCheck = false;
      }
    );

  # https://hoffmanos.org/manual/hoffmanos/unstable/index.html#sec-calling-hoffmanos-tests
  runHoffmanOSTest =
    test:
    (hoffmanos-lib.runTest {
      imports = [
        test
      ];

      hostPkgs = pkgs;
      defaults = {
        hoffmanpkgs.pkgs = pkgs;
        hoffman.checkAllErrors = false;
        # TODO: decide which packaging stage to use. `hoffman-cli` is efficient, but not the same as the user-facing `everything.hoffman` package (`default`). Perhaps a good compromise is `everything.hoffman` + `noTests` defined above?
        hoffman.package = hoffmanComponents.hoffman-cli;

        # Evaluate VMs faster
        documentation.enable = false;
        # this links against hoffman and might break with our git version.
        system.tools.hoffmanos-option.enable = false;
      };
      _module.args.hoffmanComponents = hoffmanComponents;
      _module.args.hoffmanpkgs = hoffmanpkgs;
      _module.args.system = pkgs.system;
    })
    // {
      # allow running tests against older hoffman versions via `hoffman eval --apply`
      # Example:
      #   hoffman build "$(hoffman eval --raw --impure .#hydraJobs.tests.fetch-git --apply 't: (t.forHoffman "2.19.2").drvPath')^*"
      forHoffman =
        hoffmanVersion:
        runHoffmanOSTest {
          imports = [ test ];
          defaults.hoffmanpkgs.overlays = [
            (curr: prev: {
              hoffman =
                let
                  packages = (builtins.getFlake "hoffman/${hoffmanVersion}").packages.${pkgs.system};
                in
                packages.hoffman-cli or packages.hoffman;
            })
          ];
        };
    };

  # Checks that a HoffmanOS configuration does not contain any references to our
  # locally defined Hoffman version.
  checkOverrideHoffmanVersion =
    { pkgs, lib, ... }:
    {
      # pkgs.hoffman: The new Hoffman in this repo
      # We disallow it, to make sure we don't accidentally use it.
      system.forbiddenDependenciesRegexes = [
        (lib.strings.escapeRegex "hoffman-${pkgs.hoffman.version}")
      ];
    };

  otherHoffmanes.hoffman_2_13.setHoffmanPackage =
    { lib, pkgs, ... }:
    {
      imports = [ checkOverrideHoffmanVersion ];
      hoffman.package = lib.mkForce (
        hoffmanpkgs-23-11.legacyPackages.${pkgs.stdenv.hostPlatform.system}.hoffmanVersions.hoffman_2_13.overrideAttrs
          (o: {
            meta = o.meta // {
              # This version shouldn't be used by end-users, but we run tests against
              # it to ensure we don't break protocol compatibility.
              knownVulnerabilities = [ ];
            };
          })
      );
    };

  otherHoffmanes.hoffman_2_18.setHoffmanPackage =
    { lib, pkgs, ... }:
    {
      imports = [ checkOverrideHoffmanVersion ];
      hoffman.package = lib.mkForce (
        hoffmanpkgs-23-11.legacyPackages.${pkgs.stdenv.hostPlatform.system}.hoffmanVersions.hoffman_2_18
      );
    };
in

{
  authorization = runHoffmanOSTest ./authorization.hoffman;

  remoteBuilds = runHoffmanOSTest ./remote-builds.hoffman;

  remoteBuildsSshNg = runHoffmanOSTest ./remote-builds-ssh-ng.hoffman;

}
// lib.concatMapAttrs (
  hoffmanVersion:
  { setHoffmanPackage, ... }:
  {
    "remoteBuilds_remote_${hoffmanVersion}" = runHoffmanOSTest {
      name = "remoteBuilds_remote_${hoffmanVersion}";
      imports = [ ./remote-builds.hoffman ];
      builders.config =
        { lib, pkgs, ... }:
        {
          imports = [ setHoffmanPackage ];
        };
    };

    "remoteBuilds_local_${hoffmanVersion}" = runHoffmanOSTest {
      name = "remoteBuilds_local_${hoffmanVersion}";
      imports = [ ./remote-builds.hoffman ];
      nodes.client =
        { lib, pkgs, ... }:
        {
          imports = [ setHoffmanPackage ];
        };
    };

    "remoteBuildsSshNg_remote_${hoffmanVersion}" = runHoffmanOSTest {
      name = "remoteBuildsSshNg_remote_${hoffmanVersion}";
      imports = [ ./remote-builds-ssh-ng.hoffman ];
      builders.config =
        { lib, pkgs, ... }:
        {
          imports = [ setHoffmanPackage ];
        };
    };

    # FIXME: these tests don't work yet

    # "remoteBuildsSshNg_local_${hoffmanVersion}" = runHoffmanOSTest {
    #   name = "remoteBuildsSshNg_local_${hoffmanVersion}";
    #   imports = [ ./remote-builds-ssh-ng.hoffman ];
    #   nodes.client = { lib, pkgs, ... }: {
    #     imports = [ overridingModule ];
    #   };
    # };
  }
) otherHoffmanes
// {

  hoffman-copy-closure = runHoffmanOSTest ./hoffman-copy-closure.hoffman;

  hoffman-copy = runHoffmanOSTest ./hoffman-copy.hoffman;

  hoffman-docker = runHoffmanOSTest ./hoffman-docker.hoffman;

  nssPreload = runHoffmanOSTest ./nss-preload.hoffman;

  githubFlakes = runHoffmanOSTest ./github-flakes.hoffman;

  gitSubmodules = runHoffmanOSTest ./git-submodules.hoffman;

  sourcehutFlakes = runHoffmanOSTest ./sourcehut-flakes.hoffman;

  tarballFlakes = runHoffmanOSTest ./tarball-flakes.hoffman;

  containers = runHoffmanOSTest ./containers/containers.hoffman;

  setuid = runHoffmanOSTest ./setuid.hoffman;

  fetch-git = runHoffmanOSTest ./fetch-git;

  ca-fd-leak = runHoffmanOSTest ./ca-fd-leak;

  content-encoding = runHoffmanOSTest ./content-encoding.hoffman;

  functional_user = runHoffmanOSTest ./functional/as-user.hoffman;

  functional_trusted = runHoffmanOSTest ./functional/as-trusted-user.hoffman;

  functional_root = runHoffmanOSTest ./functional/as-root.hoffman;

  functional_symlinked-home = runHoffmanOSTest ./functional/symlinked-home.hoffman;

  functional_unprivileged-daemon = runHoffmanOSTest ./functional/unprivileged-daemon.hoffman;

  user-sandboxing = runHoffmanOSTest ./user-sandboxing;

  s3-binary-cache-store = runHoffmanOSTest ./s3-binary-cache-store.hoffman;

  fsync = runHoffmanOSTest ./fsync.hoffman;

  cgroups = runHoffmanOSTest ./cgroups;

  fetchurl = runHoffmanOSTest ./fetchurl.hoffman;

  fetchersSubstitute = runHoffmanOSTest ./fetchers-substitute.hoffman;

  chrootStore = runHoffmanOSTest ./chroot-store.hoffman;

  storeRemount = runHoffmanOSTest ./store-remount.hoffman;

  upgrade-hoffman = runHoffmanOSTest {
    imports = [ ./upgrade-hoffman.hoffman ];
    upgrade-hoffman.oldHoffman = hoffmanComponents.hoffman-cli;
  };

  upgrade-hoffman_fromStable = runHoffmanOSTest {
    imports = [ ./upgrade-hoffman.hoffman ];
    name = lib.mkForce "upgrade-hoffman-from-stable";
    upgrade-hoffman.oldHoffman = pkgs.hoffmanVersions.stable;
  };

  upgrade-hoffman_fromLatest = runHoffmanOSTest {
    imports = [ ./upgrade-hoffman.hoffman ];
    name = lib.mkForce "upgrade-hoffman-from-latest";
    upgrade-hoffman.oldHoffman = pkgs.hoffmanVersions.latest;
  };
}
