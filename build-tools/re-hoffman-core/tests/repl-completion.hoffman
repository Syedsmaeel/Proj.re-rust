{
  runCommand,
  hoffman,
  expect,
}:

# We only use expect when necessary, e.g. for testing tab completion in hoffman repl.
# See also tests/functional/repl.sh

runCommand "repl-completion"
  {
    nativeBuildInputs = [
      expect
      hoffman
    ];
    expectScript = ''
      # Regression https://github.com/HoffmanOS/hoffman/pull/10778
      spawn hoffman repl --offline --extra-experimental-features hoffman-command
      expect "hoffman-repl>"
      send "foo = import ./does-not-exist.hoffman\n"
      expect "hoffman-repl>"
      send "foo.\t"
      expect {
        "hoffman-repl>" {
          puts "Got another prompt. Good."
        }
        eof {
          puts "Got EOF. Bad."
          exit 1
        }
      }
      # Regression https://github.com/HoffmanOS/hoffman/issues/15133
      # Tab-completing an expression that throws a non-EvalError (e.g.
      # JSONParseError from fromJSON) should not crash the REPL.
      send "err1 = builtins.fromJSON \"hoffmanhoffman\"\n"
      expect "hoffman-repl>"
      send "err1.\t"
      sleep 0.5
      # Send Ctrl-C to cancel the current line and get a fresh prompt,
      # since tab with no completions leaves the cursor on the same line.
      send "\x03"
      expect {
        "hoffman-repl>" {
          puts "Got another prompt after fromJSON error."
        }
        eof {
          puts "REPL crashed after fromJSON tab-complete."
          exit 1
        }
      }
      exit 0
    '';
    passAsFile = [
      "expectScript"
    ];
  }
  ''
    export HOFFMAN_STORE=$TMPDIR/store
    export HOFFMAN_STATE_DIR=$TMPDIR/state
    export HOME=$TMPDIR/home
    mkdir $HOME

    hoffman-store --init
    expect $expectScriptPath

    # FIXME: Please let's have test infrastructure that allows us to write such
    # tests in not so utterly humiliating ways.
    #
    # Write a 300-char line to the history file, then run a REPL session
    # that reads it back (read_history) and writes it out (write_history).
    histFile=$HOME/.local/share/hoffman/repl-history
    mkdir -p "$(dirname "$histFile")"
    printf '%0300d\n' 0 | tr '0' 'a' > "$histFile"
    echo "short" >> "$histFile"

    echo ":q" | hoffman repl --offline --extra-experimental-features hoffman-command

    # Verify the long line survived the read/write cycle.
    maxLen=$(awk '{ print length }' "$histFile" | sort -rn | head -1)
    if [ "$maxLen" -lt 300 ]; then
      echo "FAIL: long history line was truncated (max length: $maxLen)"
      exit 1
    fi

    touch $out
  ''
