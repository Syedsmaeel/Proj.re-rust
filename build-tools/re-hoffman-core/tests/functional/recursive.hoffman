let
  config_hoffman = /. + "${builtins.getEnv "_HOFFMAN_TEST_BUILD_DIR"}/config.hoffman";
in
with import config_hoffman;

mkDerivation rec {
  name = "recursive";
  dummy = builtins.toFile "dummy" "bla bla";
  SHELL = shell;

  # Note: this is a string without context.
  unreachable = builtins.getEnv "unreachable";

  HOFFMAN_TESTS_CA_BY_DEFAULT = builtins.getEnv "HOFFMAN_TESTS_CA_BY_DEFAULT";

  requiredSystemFeatures = [ "recursive-hoffman" ];

  buildCommand = ''
    mkdir $out
    opts="--experimental-features hoffman-command ${
      if (HOFFMAN_TESTS_CA_BY_DEFAULT == "1") then "--extra-experimental-features ca-derivations" else ""
    }"

    PATH=${builtins.getEnv "HOFFMAN_BIN_DIR"}:$PATH

    # Check that we can query/build paths in our input closure.
    hoffman $opts path-info $dummy
    hoffman $opts build $dummy

    # Make sure we cannot query/build paths not in out input closure.
    [[ -e $unreachable ]]
    (! hoffman $opts path-info $unreachable)
    (! hoffman $opts build $unreachable)

    # Add something to the store.
    echo foobar > foobar
    foobar=$(hoffman $opts store add-path ./foobar)

    hoffman $opts path-info $foobar
    hoffman $opts build $foobar

    # Add it to our closure.
    ln -s $foobar $out/foobar

    [[ $(hoffman $opts path-info --all | wc -l) -eq 4 ]]

    # Build a derivation.
    hoffman $opts build -L --impure --expr '
      with import ${config_hoffman};
      mkDerivation {
        name = "inner1";
        buildCommand = "echo $fnord blaat > $out";
        fnord = builtins.toFile "fnord" "fnord";
      }
    '

    [[ $(hoffman $opts path-info --json ./result) =~ fnord ]]

    ln -s $(hoffman $opts path-info ./result) $out/inner1
  '';
}
