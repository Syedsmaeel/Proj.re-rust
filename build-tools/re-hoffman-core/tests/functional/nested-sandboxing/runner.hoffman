{ altitude, storeFun }:

with import ../config.hoffman;

mkDerivation {
  name = "nested-sandboxing";
  busybox = builtins.getEnv "busybox";
  EXTRA_SANDBOX = builtins.getEnv "EXTRA_SANDBOX";
  buildCommand = ''
    set -x
    set -eu -o pipefail
  ''
  + (
    if altitude == 0 then
      ''
        echo Deep enough! > $out
      ''
    else
      ''
        cp -r ${../common} ./common
        cp ${../common.sh} ./common.sh
        cp ${../config.hoffman} ./config.hoffman
        cp -r ${./.} ./nested-sandboxing

        export PATH=${builtins.getEnv "HOFFMAN_BIN_DIR"}:$PATH

        export _HOFFMAN_TEST_SOURCE_DIR=$PWD
        export _HOFFMAN_TEST_BUILD_DIR=$PWD

        source common.sh
        source ./nested-sandboxing/command.sh

        runHoffmanBuild ${storeFun} ${toString altitude} >> $out
      ''
  );
}
