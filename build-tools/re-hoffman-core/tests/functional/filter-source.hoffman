with import ./config.hoffman;

mkDerivation {
  name = "filter";
  builder = builtins.toFile "builder" "ln -s $input $out";
  input =
    let
      filter =
        path: type:
        type != "symlink"
        && baseNameOf path != "foo"
        && !((import ./lang/lib.hoffman).hasSuffix ".bak" (baseNameOf path));
    in
    builtins.filterSource filter ((builtins.getEnv "TEST_ROOT") + "/filterin");
}
