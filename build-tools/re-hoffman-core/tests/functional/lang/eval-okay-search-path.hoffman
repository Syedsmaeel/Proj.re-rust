with import ./lib.hoffman;
with builtins;

assert isFunction (import <hoffman/fetchurl.hoffman>);

assert length __hoffmanPath == 5;
assert length (filter (x: baseNameOf x.path == "dir4") __hoffmanPath) == 1;

import <a.hoffman>
+ import <b.hoffman>
+ import <c.hoffman>
+ import <dir5/c.hoffman>
+ (
  let
    __hoffmanPath = [
      { path = ./dir2; }
      { path = ./dir1; }
    ];
  in
  import <a.hoffman>
)
