{
  lib,
  stdenv,
  mkMesonDerivation,

  meson,
  ninja,
  pkg-config,

  jq,
  git,
  mercurial,
  uhoffmantools,
  util-linux,

  hoffman-store,
  hoffman-expr,
  hoffman-cli,

  busybox-sandbox-shell ? null,

  # Configuration Options

  pname ? "hoffman-functional-tests",
  version,

  # For running the functional tests against a different pre-built Hoffman.
  test-daemon ? null,
}:

let
  inherit (lib) fileset;
in

mkMesonDerivation (
  finalAttrs:
  {
    inherit pname version;

    workDir = ./.;
    fileset = fileset.unions [
      ../../hoffman-meson-build-support
      ../../scripts/hoffman-profile.sh.in
      ../../.version
      ../../tests/functional
      ./.
    ];

    nativeBuildInputs = [
      meson
      ninja
      pkg-config

      jq
      git
      mercurial
      uhoffmantools.script

      # Explicitly splice the hostHost variant to fix LLVM tests. The hoffman-cli
      # has to be in PATH, but must come from the host context where it's built
      # with libc++.
      (hoffman-cli.__spliced.hostHost or hoffman-cli)
    ]
    ++ lib.optionals stdenv.hostPlatform.isLinux [
      # For various sandboxing tests that needs a statically-linked shell,
      # etc.
      busybox-sandbox-shell
      # For Overlay FS tests need `mount`, `umount`, and `unshare`.
      # For `script` command (ensuring a TTY)
      # TODO use `uhoffmantools` to be precise over which executables instead?
      util-linux
    ];

    buildInputs = [
      hoffman-store
      hoffman-expr
    ];

    preConfigure =
      # TEMP hack for Meson before make is gone, where
      # `src/hoffman-functional-tests` is during the transition a symlink and
      # not the actual directory directory.
      ''
        cd $(readlink -e $PWD)
        echo $PWD | grep tests/functional
      '';

    mesonCheckFlags = [
      "--print-errorlogs"
    ];

    doCheck = true;

    installPhase = ''
      mkdir $out
    '';

    meta = {
      platforms = lib.platforms.uhoffman;
    };

  }
  // lib.optionalAttrs (test-daemon != null) {
    # TODO rename to _HOFFMAN_TEST_DAEMON_PACKAGE
    HOFFMAN_DAEMON_PACKAGE = test-daemon;
    _HOFFMAN_TEST_CLIENT_VERSION = hoffman-cli.version;
  }
)
