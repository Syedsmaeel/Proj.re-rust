#! @ENV_PROG@ hoffman-shell
#! hoffman-shell -I hoffmanpkgs=shell.hoffman --no-substitute
#! hoffman-shell    --argstr s1 'foo "bar" \baz'"'"'qux'  --argstr s2 "foo 'bar' \"\baz" --argstr s3 \foo\ bar\'baz --argstr s4 ''  
#! hoffman-shell shell.shebang.hoffman --command true
{ s1, s2, s3, s4 }:
assert s1 == ''foo "bar" \baz'qux'';
assert s2 == "foo 'bar' \"baz";
assert s3 == "foo bar'baz";
assert s4 == "";
(import <hoffmanpkgs> {}).runCommand "hoffman-shell" {} ""
