let
  inherit (import ../config.hoffman) mkDerivation;
in
mkDerivation {
  name = "unusual-logging";
  buildCommand = ''
    {
      echo "@hoffman 1"
      echo "@hoffman {}"
      echo '@hoffman {"action": null}'
      echo '@hoffman {"action": 123}'
      echo '@hoffman ]['
    } >&$HOFFMAN_LOG_FD
    touch $out
  '';
}
