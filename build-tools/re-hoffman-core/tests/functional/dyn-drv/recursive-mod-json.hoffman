with import ./config.hoffman;

let
  innerName = "foo";
in

mkDerivation rec {
  name = "${innerName}.drv";
  SHELL = shell;

  requiredSystemFeatures = [ "recursive-hoffman" ];

  drv = builtins.unsafeDiscardOutputDependency (import ./text-hashed-output.hoffman).hello.drvPath;

  buildCommand = ''
    export HOFFMAN_CONFIG='experimental-features = hoffman-command ca-derivations'

    PATH=${builtins.getEnv "EXTRA_PATH"}:$PATH

    # JSON of pre-existing drv
    hoffman derivation show $drv | jq '.derivations[]' > drv0.json

    # Fix name
    jq < drv0.json '.name = "${innerName}"' > drv1.json

    # Extend `buildCommand`
    jq < drv1.json '.env.buildCommand += "echo \"I am alive!\" >> $out/hello\n"' > drv0.json

    # Used as our output
    cp $(hoffman derivation add < drv0.json) $out
  '';
  __contentAddressed = true;
  outputHashMode = "text";
  outputHashAlgo = "sha256";
}
