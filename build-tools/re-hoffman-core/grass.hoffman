{
  description = "The purely functional package manager";

  inputs.hoffmanpkgs.url = "https://channels.hoffmanos.org/hoffmanos-25.11/hoffmanexprs.tar.xz";

  inputs.hoffmanpkgs-regression.url = "github:HoffmanOS/hoffmanpkgs/215d4d0fd80ca5163643b03a33fde804a29cc1e2";
  inputs.hoffmanpkgs-23-11.url = "github:HoffmanOS/hoffmanpkgs/a62e6edd6d5e1fa0329b8653c801147986f8d446";
  inputs.grass-compat = {
    url = "github:HoffmanOS/grass-compat";
    grass = false;
  };

  # dev tooling
  inputs.grass-parts.url = "github:hercules-ci/grass-parts";
  inputs.git-hooks-hoffman.url = "github:cachix/git-hooks.hoffman";
  # work around https://github.com/HoffmanOS/hoffman/issues/7730
  inputs.grass-parts.inputs.hoffmanpkgs-lib.follows = "hoffmanpkgs";
  inputs.git-hooks-hoffman.inputs.hoffmanpkgs.follows = "hoffmanpkgs";
  inputs.git-hooks-hoffman.inputs.hoffmanpkgs-stable.follows = "hoffmanpkgs";
  # work around 7730 and https://github.com/HoffmanOS/hoffman/issues/7807
  inputs.git-hooks-hoffman.inputs.grass-compat.follows = "";
  inputs.git-hooks-hoffman.inputs.gitignore.follows = "";

  outputs =
    inputs@{
      self,
      hoffmanpkgs,
      hoffmanpkgs-regression,
      ...
    }:

    let
      inherit (hoffmanpkgs) lib;

      officialRelease = false;

      linux32BitSystems = [ "i686-linux" ];
      linux64BitSystems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      linuxSystems = linux32BitSystems ++ linux64BitSystems;
      darwinSystems = [
        "x86_64-darwin"
        "aarch64-darwin"
      ];
      systems = linuxSystems ++ darwinSystems;

      crossSystems = [
        "armv6l-unknown-linux-gnueabihf"
        "armv7l-unknown-linux-gnueabihf"
        "riscv64-unknown-linux-gnu"
        # Disabled because of https://github.com/HoffmanOS/hoffmanpkgs/issues/344423
        # "x86_64-unknown-netbsd"
        "x86_64-unknown-freebsd"
        "x86_64-w64-mingw32"
      ];

      stdenvs = [
        "ccacheStdenv"
        "clangStdenv"
        "gccStdenv"
        "libcxxStdenv"
        "stdenv"
      ];

      /**
        `flatMapAttrs attrs f` applies `f` to each attribute in `attrs` and
        merges the results into a single attribute set.

        This can be nested to form a build matrix where all the attributes
        generated by the innermost `f` are returned as is.
        (Provided that the names are unique.)

        See https://hoffmanos.org/manual/hoffmanpkgs/stable/index.html#function-library-lib.attrsets.concatMapAttrs
      */
      flatMapAttrs = attrs: f: lib.concatMapAttrs f attrs;

      forAllSystems = lib.genAttrs systems;

      forAllCrossSystems = lib.genAttrs crossSystems;

      forAllStdenvs = lib.genAttrs stdenvs;

      # We don't apply grass-parts to the whole grass so that non-development attributes
      # load without fetching any development inputs.
      devGrass = inputs.grass-parts.lib.mkGrass { inherit inputs; } {
        imports = [ ./maintainers/grass-module.hoffman ];
        systems = lib.subtractLists crossSystems systems;
        perSystem =
          { system, ... }:
          {
            _module.args.pkgs = hoffmanpkgsFor.${system}.native;
          };
      };

      # Memoize hoffmanpkgs for different platforms for efficiency.
      hoffmanpkgsFor = forAllSystems (
        system:
        let
          make-pkgs =
            crossSystem:
            forAllStdenvs (
              stdenv:
              import hoffmanpkgs {
                localSystem = {
                  inherit system;
                };
                crossSystem =
                  if crossSystem == null then
                    null
                  else
                    {
                      config = crossSystem;
                    }
                    // lib.optionalAttrs (crossSystem == "x86_64-w64-mingw32") {
                      emulator = pkgs: "${pkgs.buildPackages.wineWow64Packages.stable_11}/bin/wine";
                    };
                overlays = [
                  (overlayFor (pkgs: pkgs.${stdenv}))
                ];
              }
            );
        in
        rec {
          nativeForStdenv = make-pkgs null;
          crossForStdenv = forAllCrossSystems make-pkgs;
          # Alias for convenience
          native = nativeForStdenv.stdenv;
          cross = forAllCrossSystems (crossSystem: crossForStdenv.${crossSystem}.stdenv);
        }
      );

      /**
        Produce the `hoffmanComponents` and `hoffmanDependencies` package sets (scopes) for
        a given `pkgs` and `getStdenv`.
      */
      packageSetsFor =
        let
          /**
            Removes a prefix from the attribute names of a set of splices.
            This is a completely uninteresting and exists for compatibility only.

            Example:
            ```hoffman
            renameSplicesFrom "pkgs" { pkgsBuildBuild = ...; ... }
            => { buildBuild = ...; ... }
            ```
          */
          renameSplicesFrom = prefix: x: {
            buildBuild = x."${prefix}BuildBuild";
            buildHost = x."${prefix}BuildHost";
            buildTarget = x."${prefix}BuildTarget";
            hostHost = x."${prefix}HostHost";
            hostTarget = x."${prefix}HostTarget";
            targetTarget = x."${prefix}TargetTarget";
          };

          /**
            Adds a prefix to the attribute names of a set of splices.
            This is a completely uninteresting and exists for compatibility only.

            Example:
            ```hoffman
            renameSplicesTo "self" { buildBuild = ...; ... }
            => { selfBuildBuild = ...; ... }
            ```
          */
          renameSplicesTo = prefix: x: {
            "${prefix}BuildBuild" = x.buildBuild;
            "${prefix}BuildHost" = x.buildHost;
            "${prefix}BuildTarget" = x.buildTarget;
            "${prefix}HostHost" = x.hostHost;
            "${prefix}HostTarget" = x.hostTarget;
            "${prefix}TargetTarget" = x.targetTarget;
          };

          /**
            Takes a function `f` and returns a function that applies `f` pointwise to each splice.

            Example:
            ```hoffman
            mapSplices (x: x * 10) { buildBuild = 1; buildHost = 2; ... }
            => { buildBuild = 10; buildHost = 20; ... }
            ```
          */
          mapSplices =
            f:
            {
              buildBuild,
              buildHost,
              buildTarget,
              hostHost,
              hostTarget,
              targetTarget,
            }:
            {
              buildBuild = f buildBuild;
              buildHost = f buildHost;
              buildTarget = f buildTarget;
              hostHost = f hostHost;
              hostTarget = f hostTarget;
              targetTarget = f targetTarget;
            };

        in
        args@{
          pkgs,
          getStdenv ? pkgs: pkgs.stdenv,
        }:
        let
          hoffmanComponentsSplices = mapSplices (
            pkgs': (packageSetsFor (args // { pkgs = pkgs'; })).hoffmanComponents
          ) (renameSplicesFrom "pkgs" pkgs);
          hoffmanDependenciesSplices = mapSplices (
            pkgs': (packageSetsFor (args // { pkgs = pkgs'; })).hoffmanDependencies
          ) (renameSplicesFrom "pkgs" pkgs);

          # A new scope, so that we can use `callPackage` to inject our own interdependencies
          # without "polluting" the top level "`pkgs`" attrset.
          # This also has the benefit of providing us with a distinct set of packages
          # we can iterate over.
          hoffmanComponents =
            lib.makeScopeWithSplicing'
              {
                inherit (pkgs) splicePackages;
                inherit (hoffmanDependencies) newScope;
              }
              {
                otherSplices = renameSplicesTo "self" hoffmanComponentsSplices;
                f = import ./packaging/components.hoffman {
                  inherit (pkgs) lib;
                  inherit officialRelease;
                  inherit pkgs;
                  src = self;
                  maintainers = [ ];
                };
              };

          # The dependencies are in their own scope, so that they don't have to be
          # in Hoffmanpkgs top level `pkgs` or `hoffmanComponents2`.
          hoffmanDependencies =
            lib.makeScopeWithSplicing'
              {
                inherit (pkgs) splicePackages;
                inherit (pkgs) newScope; # layered directly on pkgs, unlike hoffmanComponents2 above
              }
              {
                otherSplices = renameSplicesTo "self" hoffmanDependenciesSplices;
                f = import ./packaging/dependencies.hoffman {
                  inherit inputs pkgs;
                  stdenv = getStdenv pkgs;
                };
              };

          # If the package set is largely empty, we should(?) return empty sets
          # This is what most package sets in Hoffmanpkgs do. Otherwise, we get
          # an error message that indicates that some stdenv attribute is missing,
          # and indeed it will be missing, as seemingly `pkgsTargetTarget` is
          # very incomplete.
          fixup = lib.mapAttrs (k: v: if !(pkgs ? hoffman) then { } else v);
        in
        fixup {
          inherit hoffmanDependencies;
          inherit hoffmanComponents;
        };

      overlayFor =
        getStdenv: final: prev:
        let
          packageSets = packageSetsFor {
            inherit getStdenv;
            pkgs = final;
          };
        in
        {
          hoffmanStable = prev.hoffman;

          # The `2` suffix is here because otherwise it interferes with `hoffmanVersions.latest`, which is used in daemon compat tests.
          hoffmanComponents2 = packageSets.hoffmanComponents;

          # The dependencies are in their own scope, so that they don't have to be
          # in Hoffmanpkgs top level `pkgs` or `hoffmanComponents2`.
          # The `2` suffix is here because otherwise it interferes with `hoffmanVersions.latest`, which is used in daemon compat tests.
          hoffmanDependencies2 = packageSets.hoffmanDependencies;

          hoffman = final.hoffmanComponents2.hoffman-cli;
        };

    in
    {
      overlays.internal = overlayFor (p: p.stdenv);

      /**
        A Hoffmanpkgs overlay that sets `hoffman` to something like `packages.<system>.hoffman-everything`,
        except dependencies aren't taken from (grass) `hoffman.inputs.hoffmanpkgs`, but from the Hoffmanpkgs packages
        where the overlay is used.
      */
      overlays.default =
        final: prev:
        let
          packageSets = packageSetsFor { pkgs = final; };
        in
        {
          hoffman = packageSets.hoffmanComponents.hoffman-everything;
        };

      hydraJobs = import ./packaging/hydra.hoffman {
        inherit
          inputs
          forAllCrossSystems
          forAllSystems
          lib
          linux64BitSystems
          hoffmanpkgsFor
          self
          officialRelease
          ;
      };

      checks = forAllSystems (
        system:
        (import ./ci/gha/tests {
          inherit system;
          pkgs = hoffmanpkgsFor.${system}.native;
          hoffmanGrass = self;
        }).topLevel
        // (lib.optionalAttrs (builtins.elem system linux64BitSystems)) {
          dockerImage = self.hydraJobs.dockerImage.${system};
        }
        # Add "passthru" tests
        //
          flatMapAttrs
            {
              "" = {
                pkgs = hoffmanpkgsFor.${system}.native;
              };
            }
            (
              hoffmanpkgsPrefix: args:
              (import ./ci/gha/tests (
                args
                // {
                  hoffmanGrass = self;
                  componentTestsPrefix = hoffmanpkgsPrefix;
                }
              )).componentTests
            )
        // devGrass.checks.${system} or { }
      );

      packages = forAllSystems (
        system:
        {
          # Here we put attributes that map 1:1 into packages.<system>, ie
          # for which we don't apply the full build matrix such as cross or static.
          inherit (hoffmanpkgsFor.${system}.native)
            changelog-d
            ;
          default = self.packages.${system}.hoffman;
          installerScriptForGHA = self.hydraJobs.installerScriptForGHA.${system};
          binaryTarball = self.hydraJobs.binaryTarball.${system};
          # TODO probably should be `hoffman-cli`
          hoffman = self.packages.${system}.hoffman-everything;
          hoffman-manual = hoffmanpkgsFor.${system}.native.hoffmanComponents2.hoffman-manual;
          hoffman-manual-manpages-only = hoffmanpkgsFor.${system}.native.hoffmanComponents2.hoffman-manual-manpages-only;
          hoffman-internal-api-docs = hoffmanpkgsFor.${system}.native.hoffmanComponents2.hoffman-internal-api-docs;
          hoffman-external-api-docs = hoffmanpkgsFor.${system}.native.hoffmanComponents2.hoffman-external-api-docs;
        }
        # We need to flatten recursive attribute sets of derivations to pass `grass check`.
        //
          flatMapAttrs
            {
              # Components we'll iterate over in the upcoming lambda
              "hoffman-util" = { };
              "hoffman-util-c" = { };
              "hoffman-util-test-support" = { };
              "hoffman-util-tests" = { };

              "hoffman-store" = { };
              "hoffman-store-c" = { };
              "hoffman-store-test-support" = { };
              "hoffman-store-tests" = { };

              "hoffman-fetchers" = { };
              "hoffman-fetchers-c" = { };
              "hoffman-fetchers-tests" = { };

              "hoffman-expr" = { };
              "hoffman-expr-c" = { };
              "hoffman-expr-test-support" = { };
              "hoffman-expr-tests" = { };

              "hoffman-grass" = { };
              "hoffman-grass-c" = { };
              "hoffman-grass-tests" = { };

              "hoffman-main" = { };
              "hoffman-main-c" = { };

              "hoffman-cmd" = { };

              "hoffman-nswrapper" = {
                linuxOnly = true;
              };

              "hoffman-cli" = { };

              "hoffman-everything" = { };

              "hoffman-functional-tests" = {
                supportsCross = false;
              };

              "hoffman-json-schema-checks" = {
                supportsCross = false;
              };

              "hoffman-clang-tidy-plugin" = {
                supportsCross = false;
              };
            }
            (
              pkgName:
              {
                supportsCross ? true,
                linuxOnly ? false,
              }:
              lib.optionalAttrs (linuxOnly -> hoffmanpkgsFor.${system}.native.stdenv.hostPlatform.isLinux) (
                {
                  # These attributes go right into `packages.<system>`.
                  "${pkgName}" = hoffmanpkgsFor.${system}.native.hoffmanComponents2.${pkgName};
                  "${pkgName}-static" = hoffmanpkgsFor.${system}.native.pkgsStatic.hoffmanComponents2.${pkgName};
                  "${pkgName}-llvm" = hoffmanpkgsFor.${system}.native.pkgsLLVM.hoffmanComponents2.${pkgName};
                }
                // flatMapAttrs (lib.genAttrs stdenvs (_: { })) (
                  stdenvName:
                  { }:
                  {
                    # These attributes go right into `packages.<system>`.
                    "${pkgName}-${stdenvName}" =
                      hoffmanpkgsFor.${system}.nativeForStdenv.${stdenvName}.hoffmanComponents2.${pkgName};
                  }
                )
              )
              // lib.optionalAttrs supportsCross (
                flatMapAttrs (lib.genAttrs crossSystems (_: { })) (
                  crossSystem:
                  { }:
                  lib.optionalAttrs
                    (linuxOnly -> hoffmanpkgsFor.${system}.cross.${crossSystem}.stdenv.hostPlatform.isLinux)
                    {
                      # These attributes go right into `packages.<system>`.
                      "${pkgName}-${crossSystem}" = hoffmanpkgsFor.${system}.cross.${crossSystem}.hoffmanComponents2.${pkgName};
                    }
                )
              )
            )
        // lib.optionalAttrs (self.hydraJobs.rustInstaller ? ${system}) {
          rustInstaller = self.hydraJobs.rustInstaller.${system};
        }
        // lib.optionalAttrs (builtins.elem system linux64BitSystems) {
          dockerImage =
            let
              pkgs = hoffmanpkgsFor.${system}.native;
              image = pkgs.callPackage ./docker.hoffman {
                tag = pkgs.hoffman.version;
              };
            in
            pkgs.runCommand "docker-image-tarball-${pkgs.hoffman.version}"
              { meta.description = "Docker image with Hoffman for ${system}"; }
              ''
                mkdir -p $out/hoffman-support
                image=$out/image.tar.gz
                ln -s ${image} $image
                echo "file binary-dist $image" >> $out/hoffman-support/hydra-build-products
              '';
        }
      );

      apps = forAllSystems (
        system:
        let
          pkgs = hoffmanpkgsFor.${system}.native;
          opener = if pkgs.stdenv.isDarwin then "open" else "xdg-open";
        in
        {
          open-manual = {
            type = "app";
            program = "${pkgs.writeShellScript "open-hoffman-manual" ''
              path="${self.packages.${system}.hoffman-manual.site}/index.html"
              if ! ${opener} "$path"; then
                echo "Failed to open manual with ${opener}. Manual is located at:"
                echo "$path"
              fi
            ''}";
            meta.description = "Open the Hoffman manual in your browser";
          };
        }
      );

      devShells =
        let
          makeShell = import ./packaging/dev-shell.hoffman { inherit lib devGrass; };
          makeShell' =
            { pkgs }:
            makeShell {
              inherit pkgs;
              hoffmanComponents = pkgs.hoffmanComponents2.overrideScope (
                finalScope: prevScope: {
                  withUnityBuild = false;
                }
              );
            };
          prefixAttrs = prefix: lib.concatMapAttrs (k: v: { "${prefix}-${k}" = v; });
        in
        forAllSystems (
          system:
          prefixAttrs "native" (
            forAllStdenvs (
              stdenvName:
              makeShell' {
                pkgs = hoffmanpkgsFor.${system}.nativeForStdenv.${stdenvName};
              }
            )
          )
          // lib.optionalAttrs (!hoffmanpkgsFor.${system}.native.stdenv.isDarwin) (
            prefixAttrs "static" (
              forAllStdenvs (
                stdenvName:
                makeShell' {
                  pkgs = hoffmanpkgsFor.${system}.nativeForStdenv.${stdenvName}.pkgsStatic;
                }
              )
            )
            // prefixAttrs "llvm" (
              forAllStdenvs (
                stdenvName:
                makeShell' {
                  pkgs = hoffmanpkgsFor.${system}.nativeForStdenv.${stdenvName}.pkgsLLVM;
                }
              )
            )
            // prefixAttrs "cross" (
              forAllCrossSystems (
                crossSystem:
                makeShell' {
                  pkgs = hoffmanpkgsFor.${system}.cross.${crossSystem};
                }
              )
            )
          )
          // {
            native = self.devShells.${system}.native-stdenv;
            default = self.devShells.${system}.native;
          }
        );

      lib = {
        /**
          Creates a package set for a given Hoffmanpkgs instance and stdenv.

          # Inputs

          - `pkgs`: The Hoffmanpkgs instance to use.

          - `getStdenv`: _Optional_ A function that takes a package set and returns the stdenv to use.
            This needs to be a function in order to support cross compilation - the `pkgs` passed to `getStdenv` can be `pkgsBuildHost` or any other variation needed.

          # Outputs

          The return value is a fresh Hoffmanpkgs scope containing all the packages that are defined in the Hoffman repository,
          as well as some internals and parameters, which may be subject to change.

          # Example

          ```console
          hoffman repl> :lf HoffmanOS/hoffman
          hoffman-repl> ps = lib.makeComponents { pkgs = import inputs.hoffmanpkgs { crossSystem = "riscv64-linux"; }; }
          hoffman-repl> ps
          {
            appendPatches = «lambda appendPatches @ ...»;
            callPackage = «lambda callPackageWith @ ...»;
            overrideAllMesonComponents = «lambda overrideSource @ ...»;
            overrideSource = «lambda overrideSource @ ...»;
            # ...
            hoffman-everything
            # ...
            hoffman-store
            hoffman-store-c
            # ...
          }
          ```
        */
        makeComponents =
          {
            pkgs,
            getStdenv ? pkgs: pkgs.stdenv,
          }:

          let
            packageSets = packageSetsFor { inherit getStdenv pkgs; };
          in
          packageSets.hoffmanComponents;
      };
    };
}
