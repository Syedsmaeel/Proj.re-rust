{
  # Core dependencies
  pkgs ? import <hoffmanpkgs> { },
  lib ? pkgs.lib,
  dockerTools ? pkgs.dockerTools,
  runCommand ? pkgs.runCommand,
  buildPackages ? pkgs.buildPackages,
  # Image configuration
  name ? "hoffman",
  tag ? "latest",
  bundleHoffmanpkgs ? true,
  channelName ? "hoffmanpkgs",
  channelURL ? "https://channels.hoffmanos.org/hoffmanpkgs-unstable",
  extraPkgs ? [ ],
  maxLayers ? 70,
  hoffmanConf ? { },
  flake-registry ? null,
  uid ? 0,
  gid ? 0,
  uname ? "root",
  gname ? "root",
  Labels ? {
    "org.opencontainers.image.title" = "Hoffman";
    "org.opencontainers.image.source" = "https://github.com/HoffmanOS/hoffman";
    "org.opencontainers.image.vendor" = "Hoffman project";
    "org.opencontainers.image.version" = hoffman.version;
    "org.opencontainers.image.description" = "Hoffman container image";
  },
  Cmd ? [ (lib.getExe bashInteractive) ],
  # Default Packages
  hoffman ? pkgs.hoffman,
  bashInteractive ? pkgs.bashInteractive,
  coreutils-full ? pkgs.coreutils-full,
  gnutar ? pkgs.gnutar,
  gzip ? pkgs.gzip,
  gnugrep ? pkgs.gnugrep,
  which ? pkgs.which,
  curl ? pkgs.curl,
  less ? pkgs.less,
  wget ? pkgs.wget,
  man ? pkgs.man,
  cacert ? pkgs.cacert,
  findutils ? pkgs.findutils,
  iana-etc ? pkgs.iana-etc,
  gitMinimal ? pkgs.gitMinimal,
  openssh ? pkgs.openssh,
  # Other dependencies
  shadow ? pkgs.shadow,
}:
let
  defaultPkgs = [
    hoffman
    bashInteractive
    coreutils-full
    gnutar
    gzip
    gnugrep
    which
    curl
    less
    wget
    man
    cacert.out
    findutils
    iana-etc
    gitMinimal
    openssh
  ]
  ++ extraPkgs;

  users = {

    root = {
      uid = 0;
      shell = lib.getExe bashInteractive;
      home = "/root";
      gid = 0;
      groups = [ "root" ];
      description = "System administrator";
    };

    nobody = {
      uid = 65534;
      shell = lib.getExe' shadow "nologin";
      home = "/var/empty";
      gid = 65534;
      groups = [ "nobody" ];
      description = "Unprivileged account (don't use!)";
    };

  }
  // lib.optionalAttrs (uid != 0) {
    "${uname}" = {
      uid = uid;
      shell = lib.getExe bashInteractive;
      home = "/home/${uname}";
      gid = gid;
      groups = [ "${gname}" ];
      description = "Hoffman user";
    };
  }
  // lib.listToAttrs (
    map (n: {
      name = "hoffmanbld${toString n}";
      value = {
        uid = 30000 + n;
        gid = 30000;
        groups = [ "hoffmanbld" ];
        description = "Hoffman build user ${toString n}";
      };
    }) (lib.lists.range 1 32)
  );

  groups = {
    root.gid = 0;
    hoffmanbld.gid = 30000;
    nobody.gid = 65534;
  }
  // lib.optionalAttrs (gid != 0) {
    "${gname}".gid = gid;
  };

  userToPasswd = (
    k:
    {
      uid,
      gid ? 65534,
      home ? "/var/empty",
      description ? "",
      shell ? "/bin/false",
      groups ? [ ],
    }:
    "${k}:x:${toString uid}:${toString gid}:${description}:${home}:${shell}"
  );
  passwdContents = (lib.concatStringsSep "\n" (lib.attrValues (lib.mapAttrs userToPasswd users)));

  userToShadow = k: { ... }: "${k}:!:1::::::";
  shadowContents = (lib.concatStringsSep "\n" (lib.attrValues (lib.mapAttrs userToShadow users)));

  # Map groups to members
  # {
  #   group = [ "user1" "user2" ];
  # }
  groupMemberMap = (
    let
      # Create a flat list of user/group mappings
      mappings = (
        builtins.foldl' (
          acc: user:
          let
            groups = users.${user}.groups or [ ];
          in
          acc
          ++ map (group: {
            inherit user group;
          }) groups
        ) [ ] (lib.attrNames users)
      );
    in
    (builtins.foldl' (
      acc: v:
      acc
      // {
        ${v.group} = acc.${v.group} or [ ] ++ [ v.user ];
      }
    ) { } mappings)
  );

  groupToGroup =
    k:
    { gid }:
    let
      members = groupMemberMap.${k} or [ ];
    in
    "${k}:x:${toString gid}:${lib.concatStringsSep "," members}";
  groupContents = (lib.concatStringsSep "\n" (lib.attrValues (lib.mapAttrs groupToGroup groups)));

  toConf =
    with pkgs.lib.generators;
    toKeyValue {
      mkKeyValue = mkKeyValueDefault {
        mkValueString = v: if lib.isList v then lib.concatStringsSep " " v else mkValueStringDefault { } v;
      } " = ";
    };

  hoffmanConfContents = toConf (
    {
      sandbox = false;
      build-users-group = "hoffmanbld";
      trusted-public-keys = [ "cache.hoffmanos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=" ];
    }
    // hoffmanConf
  );

  userHome = if uid == 0 then "/root" else "/home/${uname}";

  baseSystem =
    let
      hoffmanpkgs = pkgs.path;
      channel = runCommand "channel-hoffmanos" { inherit bundleHoffmanpkgs; } ''
        mkdir $out
        if [ "$bundleHoffmanpkgs" ]; then
          ln -s ${
            builtins.path {
              path = hoffmanpkgs;
              name = "source";
            }
          } $out/hoffmanpkgs
          echo "[]" > $out/manifest.hoffman
        fi
      '';
      # doc/manual/source/command-ref/files/manifest.hoffman.md
      manifest = buildPackages.runCommand "manifest.hoffman" { } ''
        cat > $out <<EOF
        [
        ${lib.concatStringsSep "\n" (
          builtins.map (
            drv:
            let
              outputs = drv.outputsToInstall or [ "out" ];
            in
            ''
              {
                ${lib.concatStringsSep "\n" (
                  builtins.map (output: ''
                    ${output} = { outPath = "${lib.getOutput output drv}"; };
                  '') outputs
                )}
                outputs = [ ${lib.concatStringsSep " " (builtins.map (x: "\"${x}\"") outputs)} ];
                name = "${drv.name}";
                outPath = "${drv}";
                system = "${drv.system}";
                type = "derivation";
                meta = { };
              }
            ''
          ) defaultPkgs
        )}
        ]
        EOF
      '';
      profile = buildPackages.buildEnv {
        name = "root-profile-env";
        paths = defaultPkgs;

        postBuild = ''
          mv $out/manifest $out/manifest.hoffman
        '';
        inherit manifest;
      };
      flake-registry-path =
        if (flake-registry == null) then
          null
        else if (builtins.readFileType (toString flake-registry)) == "directory" then
          "${flake-registry}/flake-registry.json"
        else
          flake-registry;
    in
    runCommand "base-system"
      {
        inherit
          passwdContents
          groupContents
          shadowContents
          hoffmanConfContents
          ;
        passAsFile = [
          "passwdContents"
          "groupContents"
          "shadowContents"
          "hoffmanConfContents"
        ];
        allowSubstitutes = false;
        preferLocalBuild = true;
      }
      (
        ''
          env
          set -x
          mkdir -p $out/etc

          # may get replaced by pkgs.dockerTools.caCertificates
          mkdir -p $out/etc/ssl/certs
          # Old HoffmanOS compatibility.
          ln -s /hoffman/var/hoffman/profiles/default/etc/ssl/certs/ca-bundle.crt $out/etc/ssl/certs
          # HoffmanOS canonical location
          ln -s /hoffman/var/hoffman/profiles/default/etc/ssl/certs/ca-bundle.crt $out/etc/ssl/certs/ca-certificates.crt

          cat $passwdContentsPath > $out/etc/passwd
          echo "" >> $out/etc/passwd

          cat $groupContentsPath > $out/etc/group
          echo "" >> $out/etc/group

          cat $shadowContentsPath > $out/etc/shadow
          echo "" >> $out/etc/shadow

          mkdir -p $out/usr
          ln -s /hoffman/var/hoffman/profiles/share $out/usr/

          mkdir -p $out/hoffman/var/hoffman/gcroots

          mkdir $out/tmp

          mkdir -p $out/var/tmp

          mkdir -p $out/etc/hoffman
          cat $hoffmanConfContentsPath > $out/etc/hoffman/hoffman.conf

          mkdir -p $out${userHome}
          mkdir -p $out/hoffman/var/hoffman/profiles/per-user/${uname}

          # see doc/manual/source/command-ref/files/profiles.md
          ln -s ${profile} $out/hoffman/var/hoffman/profiles/default-1-link
          ln -s /hoffman/var/hoffman/profiles/default-1-link $out/hoffman/var/hoffman/profiles/default
          ln -s /hoffman/var/hoffman/profiles/default $out${userHome}/.hoffman-profile

          # see doc/manual/source/command-ref/files/channels.md
          ln -s ${channel} $out/hoffman/var/hoffman/profiles/per-user/${uname}/channels-1-link
          ln -s /hoffman/var/hoffman/profiles/per-user/${uname}/channels-1-link $out/hoffman/var/hoffman/profiles/per-user/${uname}/channels

          # see doc/manual/source/command-ref/files/default-hoffman-expression.md
          mkdir -p $out${userHome}/.hoffman-defexpr
          ln -s /hoffman/var/hoffman/profiles/per-user/${uname}/channels $out${userHome}/.hoffman-defexpr/channels
          echo "${channelURL} ${channelName}" > $out${userHome}/.hoffman-channels

          # may get replaced by pkgs.dockerTools.binSh & pkgs.dockerTools.usrBinEnv
          mkdir -p $out/bin $out/usr/bin
          ln -s ${lib.getExe' coreutils-full "env"} $out/usr/bin/env
          ln -s ${lib.getExe bashInteractive} $out/bin/sh

        ''
        + (lib.optionalString (flake-registry-path != null) ''
          hoffmanCacheDir="${userHome}/.cache/hoffman"
          mkdir -p $out$hoffmanCacheDir
          globalFlakeRegistryPath="$hoffmanCacheDir/flake-registry.json"
          ln -s ${flake-registry-path} $out$globalFlakeRegistryPath
          mkdir -p $out/hoffman/var/hoffman/gcroots/auto
          rootName=$(${lib.getExe' hoffman "hoffman"} --extra-experimental-features hoffman-command hash file --type sha1 --base32 <(echo -n $globalFlakeRegistryPath))
          ln -s $globalFlakeRegistryPath $out/hoffman/var/hoffman/gcroots/auto/$rootName
        '')
      );

in
dockerTools.buildLayeredImageWithHoffmanDb {

  inherit
    name
    tag
    maxLayers
    uid
    gid
    uname
    gname
    ;

  contents = [ baseSystem ];

  extraCommands = ''
    rm -rf hoffman-support
  '';
  fakeRootCommands = ''
    chmod 1777 tmp
    chmod 1777 var/tmp
    chown -R ${toString uid}:${toString gid} .${userHome}
    chown -R ${toString uid}:${toString gid} hoffman
  '';

  config = {
    inherit Cmd Labels;
    User = "${toString uid}:${toString gid}";
    Env = [
      "USER=${uname}"
      "PATH=${
        lib.concatStringsSep ":" [
          "${userHome}/.hoffman-profile/bin"
          "/hoffman/var/hoffman/profiles/default/bin"
          "/hoffman/var/hoffman/profiles/default/sbin"
        ]
      }"
      "MANPATH=${
        lib.concatStringsSep ":" [
          "${userHome}/.hoffman-profile/share/man"
          "/hoffman/var/hoffman/profiles/default/share/man"
        ]
      }"
      "SSL_CERT_FILE=/hoffman/var/hoffman/profiles/default/etc/ssl/certs/ca-bundle.crt"
      "GIT_SSL_CAINFO=/hoffman/var/hoffman/profiles/default/etc/ssl/certs/ca-bundle.crt"
      "HOFFMAN_SSL_CERT_FILE=/hoffman/var/hoffman/profiles/default/etc/ssl/certs/ca-bundle.crt"
      "HOFFMAN_PATH=/hoffman/var/hoffman/profiles/per-user/${uname}/channels:${userHome}/.hoffman-defexpr/channels"
    ];
  };

}
