# Only execute this file once per shell.
# This file is tested by tests/installer/default.hoffman.
if [ -n "${__ETC_PROFILE_HOFFMAN_SOURCED:-}" ]; then return; fi
export __ETC_PROFILE_HOFFMAN_SOURCED=1

HOFFMAN_LINK=$HOME/.hoffman-profile
if [ -n "${XDG_STATE_HOME-}" ]; then
    HOFFMAN_LINK_NEW="$XDG_STATE_HOME/hoffman/profile"
else
    HOFFMAN_LINK_NEW=$HOME/.local/state/hoffman/profile
fi
if [ -e "$HOFFMAN_LINK_NEW" ]; then
    if [ -t 2 ] && [ -e "$HOFFMAN_LINK" ]; then
        warning="\033[1;35mwarning:\033[0m"
        printf "$warning Both %s and legacy %s exist; using the former.\n" "$HOFFMAN_LINK_NEW" "$HOFFMAN_LINK" 1>&2
        if [ "$(realpath "$HOFFMAN_LINK")" = "$(realpath "$HOFFMAN_LINK_NEW")" ]; then
            printf "         Since the profiles match, you can safely delete either of them.\n" 1>&2
        else
            # This should be an exceptionally rare occasion: the only way to get it would be to
            # 1. Update to newer Hoffman;
            # 2. Remove .hoffman-profile;
            # 3. Set the $HOFFMAN_LINK_NEW to something other than the default user profile;
            # 4. Roll back to older Hoffman.
            # If someone did all that, they can probably figure out how to migrate the profile.
            printf "$warning Profiles do not match. You should manually migrate from %s to %s.\n" "$HOFFMAN_LINK" "$HOFFMAN_LINK_NEW" 1>&2
        fi
    fi
    HOFFMAN_LINK="$HOFFMAN_LINK_NEW"
fi

export HOFFMAN_PROFILES="@localstatedir@/hoffman/profiles/default $HOFFMAN_LINK"

# Populate bash completions, .desktop files, etc
if [ -z "${XDG_DATA_DIRS-}" ]; then
    # According to XDG spec the default is /usr/local/share:/usr/share, don't set something that prevents that default
    export XDG_DATA_DIRS="/usr/local/share:/usr/share:$HOFFMAN_LINK/share:/hoffman/var/hoffman/profiles/default/share"
else
    export XDG_DATA_DIRS="$XDG_DATA_DIRS:$HOFFMAN_LINK/share:/hoffman/var/hoffman/profiles/default/share"
fi

# Set $HOFFMAN_SSL_CERT_FILE so that Hoffmanpkgs applications like curl work.
if [ -n "${HOFFMAN_SSL_CERT_FILE:-}" ]; then
    : # Allow users to override the HOFFMAN_SSL_CERT_FILE
elif [ -e /etc/ssl/certs/ca-certificates.crt ]; then # HoffmanOS, Ubuntu, Debian, Gentoo, Arch
    export HOFFMAN_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
elif [ -e /etc/ssl/ca-bundle.pem ]; then # openSUSE Tumbleweed
    export HOFFMAN_SSL_CERT_FILE=/etc/ssl/ca-bundle.pem
elif [ -e /etc/ssl/certs/ca-bundle.crt ]; then # Old HoffmanOS
    export HOFFMAN_SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
elif [ -e /etc/pki/tls/certs/ca-bundle.crt ]; then # Fedora, CentOS
    export HOFFMAN_SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
else
  # Fall back to what is in the hoffman profiles, favouring whatever is defined last.
  check_hoffman_profiles() {
    if [ -n "${ZSH_VERSION:-}" ]; then
      # Zsh by default doesn't split words in unquoted parameter expansion.
      # Set local_options for these options to be reverted at the end of the function
      # and shwordsplit to force splitting words in $HOFFMAN_PROFILES below.
      setopt local_options shwordsplit
    fi
    for i in $HOFFMAN_PROFILES; do
      if [ -e "$i/etc/ssl/certs/ca-bundle.crt" ]; then
        export HOFFMAN_SSL_CERT_FILE=$i/etc/ssl/certs/ca-bundle.crt
      fi
    done
  }
  check_hoffman_profiles
  unset -f check_hoffman_profiles
fi

export PATH="$HOFFMAN_LINK/bin:@localstatedir@/hoffman/profiles/default/bin:$PATH"
unset HOFFMAN_LINK HOFFMAN_LINK_NEW
