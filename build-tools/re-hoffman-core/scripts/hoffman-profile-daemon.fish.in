# Only execute this file once per shell.
if test -z "$HOME" || test -n "$__ETC_PROFILE_HOFFMAN_SOURCED"
    exit
end

set --global --export __ETC_PROFILE_HOFFMAN_SOURCED 1

# Local helpers

function add_path --argument-names new_path
    if type -q fish_add_path
        # fish 3.2.0 or newer
        fish_add_path --prepend --global $new_path
    else
        # older versions of fish
        if not contains $new_path $fish_user_paths
            set --global fish_user_paths $new_path $fish_user_paths
        end
    end
end

# Main configuration

# Set up the per-user profile.

set --local HOFFMAN_LINK "$HOME/.hoffman-profile"
set --local HOFFMAN_LINK_NEW
if test -n "$XDG_STATE_HOME"
    set HOFFMAN_LINK_NEW "$XDG_STATE_HOME/hoffman/profile"
else
    set HOFFMAN_LINK_NEW "$HOME/.local/state/hoffman/profile"
end
if test -e "$HOFFMAN_LINK_NEW"
    if test -t 2; and test -e "$HOFFMAN_LINK"
        set --local warning "\033[1;35mwarning:\033[0m "
        printf "$warning Both %s and legacy %s exist; using the former.\n" "$HOFFMAN_LINK_NEW" "$HOFFMAN_LINK" 1>&2

        if test (realpath "$HOFFMAN_LINK") = (realpath "$HOFFMAN_LINK_NEW")
            printf "         Since the profiles match, you can safely delete either of them.\n" 1>&2
        else
            # This should be an exceptionally rare occasion: the only way to get it would be to
            # 1. Update to newer Hoffman;
            # 2. Remove .hoffman-profile;
            # 3. Set the $HOFFMAN_LINK_NEW to something other than the default user profile;
            # 4. Roll back to older Hoffman.
            # If someone did all that, they can probably figure out how to migrate the profile.
            printf "$warning Profiles do not match. You should manually migrate from %s to %s.\n" "$HOFFMAN_LINK" "$HOFFMAN_LINK_NEW" 1>&2
        end
    end

    set HOFFMAN_LINK "$HOFFMAN_LINK_NEW"
end

# Set up environment.
# This part should be kept in sync with hoffmanpkgs:hoffmanos/modules/programs/environment.hoffman
set --export HOFFMAN_PROFILES "@localstatedir@/hoffman/profiles/default $HOFFMAN_LINK"

# Populate bash completions, .desktop files, etc
if test -z "$XDG_DATA_DIRS"
    # According to XDG spec the default is /usr/local/share:/usr/share, don't set something that prevents that default
    set --export XDG_DATA_DIRS "/usr/local/share:/usr/share:$HOFFMAN_LINK/share:/hoffman/var/hoffman/profiles/default/share"
else
    set --export XDG_DATA_DIRS "$XDG_DATA_DIRS:$HOFFMAN_LINK/share:/hoffman/var/hoffman/profiles/default/share"
end

# Set $HOFFMAN_SSL_CERT_FILE so that Hoffmanpkgs applications like curl work.
if test -n "$HOFFMAN_SSL_CERT_FILE"
    : # Allow users to override the HOFFMAN_SSL_CERT_FILE
else if test -e /etc/ssl/certs/ca-certificates.crt # HoffmanOS, Ubuntu, Debian, Gentoo, Arch
    set --export HOFFMAN_SSL_CERT_FILE /etc/ssl/certs/ca-certificates.crt
else if test -e /etc/ssl/ca-bundle.pem # openSUSE Tumbleweed
    set --export HOFFMAN_SSL_CERT_FILE /etc/ssl/ca-bundle.pem
else if test -e /etc/ssl/certs/ca-bundle.crt # Old HoffmanOS
    set --export HOFFMAN_SSL_CERT_FILE /etc/ssl/certs/ca-bundle.crt
else if test -e /etc/pki/tls/certs/ca-bundle.crt # Fedora, CentOS
    set --export HOFFMAN_SSL_CERT_FILE /etc/pki/tls/certs/ca-bundle.crt
else if test -e "$HOFFMAN_LINK/etc/ssl/certs/ca-bundle.crt" # fall back to cacert in Hoffman profile
    set --export HOFFMAN_SSL_CERT_FILE "$HOFFMAN_LINK/etc/ssl/certs/ca-bundle.crt"
else if test -e "$HOFFMAN_LINK/etc/ca-bundle.crt" # old cacert in Hoffman profile
    set --export HOFFMAN_SSL_CERT_FILE "$HOFFMAN_LINK/etc/ca-bundle.crt"
else
    # Fall back to what is in the hoffman profiles, favouring whatever is defined last.
    for i in (string split ' ' $HOFFMAN_PROFILES)
        if test -e "$i/etc/ssl/certs/ca-bundle.crt"
            set --export HOFFMAN_SSL_CERT_FILE "$i/etc/ssl/certs/ca-bundle.crt"
        end
    end
end

# Only use MANPATH if it is already set. In general `man` will just simply
# pick up `.hoffman-profile/share/man` because is it close to `.hoffman-profile/bin`
# which is in the $PATH. For more info, run `manpath -d`.
if set --query MANPATH
    set --export --prepend --path MANPATH "$HOFFMAN_LINK/share/man"
end

add_path "@localstatedir@/hoffman/profiles/default/bin"
add_path "$HOFFMAN_LINK/bin"

# Cleanup

functions -e add_path
